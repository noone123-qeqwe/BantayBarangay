# ==========================================
# BantayBarangay Environment Configuration
# ==========================================

# Application Environment
NODE_ENV=production

# HTTP Port (Cloud hosts like Render / Railway / Heroku auto-assign this via process.env.PORT)
PORT=3000

# Standalone Admin Port (Used when running both locally)
ADMIN_PORT=3001

# ── Cloud Deployment (Separate Services) ─────────────────────
# If deploying Citizen Portal and Admin Portal as two separate services (e.g., Render, Railway):
#
# Service 1: Citizen Web Service
#   - Build Command: npm install (or none needed)
#   - Start Command: npm run start:resident
#   - Set ADMIN_URL to your Admin Service URL:
#     ADMIN_URL=https://bantay-admin.onrender.com
#
# Service 2: Admin Web Service
#   - Build Command: npm install (or none needed)
#   - Start Command: npm run start:admin
#   - Set RESIDENT_URL to your Citizen Service URL:
#     RESIDENT_URL=https://bantay-resident.onrender.com
# ─────────────────────────────────────────────────────────────
# ADMIN_URL=https://bantay-admin.onrender.com
# RESIDENT_URL=https://bantay-resident.onrender.com

# SQLite Database Path (Optional - defaults to ./database/bantaybarangay.db)
# If using a persistent disk mount on Render/Railway, set to: /var/data/bantaybarangay.db
# BANTAYBARANGAY_DB_PATH=./database/bantaybarangay.db

# SMS Gateway (TextBee.dev) Configuration
SMS_ENABLED=false
TEXTBEE_API_KEY=your_api_key_here
TEXTBEE_DEVICE_ID=your_device_id_here

