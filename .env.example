# ==============================================================================
# BantayBarangay Production Environment Configuration
# ==============================================================================
# This file defines all environment variables required or supported by the
# BantayBarangay application. Copy this file to .env or configure these in your
# hosting provider's dashboard (e.g., Render Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# PostgreSQL connection string provided by Render PostgreSQL or external provider.
# Render PostgreSQL internal connection string format:
# DATABASE_URL="postgresql://user:password@dpg-xxxx-a:5432/bantaybarangay_db?sslmode=require"
DATABASE_URL="postgresql://user:password@host:5432/bantaybarangay?sslmode=require"

# (Optional) Direct database connection string (if using connection pooling like PgBouncer or Supabase)
# DIRECT_URL="postgresql://user:password@host:5432/bantaybarangay"

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication cookies and CAPTCHA challenge tokens.
# Generate a secure 32+ character random string (e.g. `openssl rand -base64 32`).
# CRITICAL: Must be kept secret. Do not commit your real secret to version control.
JWT_SECRET="generate-a-secure-random-32-character-secret-key-here"

# Node environment mode: set to "production" on Render
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. SMS & OTP NOTIFICATIONS (Recommended for live SMS)
# ------------------------------------------------------------------------------
# Semaphore SMS API Key (https://semaphore.co).
# If omitted or empty, OTP codes will only print to server console logs (dev fallback mode).
SEMAPHORE_API_KEY=""

# Optional sender name registered with Semaphore (maximum 11 alphanumeric characters).
# Defaults to "BantayBrgy" if not specified.
SEMAPHORE_SENDER_NAME="BantayBrgy"

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API Key (https://aistudio.google.com/)
# Used for report categorization, safety triage, and resident report summarization.
# If omitted, system falls back to OpenAI or local rule-based heuristic classifier.
GEMINI_API_KEY=""

# OpenAI API Key (https://platform.openai.com/)
# Secondary fallback AI provider if Gemini is unreachable or not configured.
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. PUBLIC CLIENT-SIDE BRANDING (Optional)
# ------------------------------------------------------------------------------
# Note: Variables prefixed with NEXT_PUBLIC_ are embedded into the client bundle at build time.
NEXT_PUBLIC_APP_NAME="BantayBarangay"
NEXT_PUBLIC_BARANGAY_NAME="Barangay San Antonio"
NEXT_PUBLIC_CITY_NAME="Pasig City"

# ------------------------------------------------------------------------------
# 6. LOCAL UPLOADS DIRECTORY (Optional)
# ------------------------------------------------------------------------------
# Local filesystem path for report photo uploads.
# Note: On Render Web Services without persistent disks, storage is ephemeral.
UPLOAD_DIR="./public/uploads"
